# ── Supabase ──────────────────────────────────────────────────────────────
# Da: Supabase Dashboard → Project Settings → API
# Stessi valori esposti sia lato client (prefisso VITE_) sia lato server.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Chiave segreta lato server (Settings → API → service_role). NON esporre mai
# al client, non prefissarla con VITE_. Serve solo alle server function che
# devono bypassare le Row Level Security policies.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI provider (per le previsioni) ─────────────────────────────────────
# Di default punta a Groq, che ha un piano gratuito senza carta di credito
# (https://console.groq.com/keys). Per usarne un altro basta cambiare
# AI_BASE_URL/AI_MODEL: OpenRouter → https://openrouter.ai/api/v1,
# OpenAI (a pagamento) → https://api.openai.com/v1.
AI_API_KEY=gsk_your-groq-api-key
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# ── App ───────────────────────────────────────────────────────────────────
VITE_APP_NAME=Candlestick AI
VITE_APP_URL=http://localhost:3000

# ── AI provider - visione (estrazione candele da foto) ──────────────────
# Google Gemini (aistudio.google.com/apikey, piano gratuito ~1500 richieste/giorno).
# Serve solo per la pagina "Inserimento manuale": legge la foto del grafico.
VISION_API_KEY=your-gemini-key
VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
VISION_MODEL=gemini-2.5-flash

# ── Dati di mercato ──────────────────────────────────────────────────────
# Twelve Data (twelvedata.com/pricing, piano gratuito: 800 richieste/giorno).
TWELVE_DATA_API_KEY=your-twelve-data-key
